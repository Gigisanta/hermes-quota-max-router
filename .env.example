# Runtime process environment only. Put real values in ~/.hermes/.env or the
# project secret store; never commit them or load unrelated project's keys.
REDIS_URL=redis://127.0.0.1:6379/0
ROUTER_VERIFIED_MODELS=var/verified-models.json
ROUTER_DAILY_PEAK_FILE=var/daily-peak.json
ROUTER_QUEUE_DB=var/queue.sqlite3
ROUTER_TOKEN_JOURNAL=
ROUTER_TOKEN_SIMON_NEWS=
ROUTER_TOKEN_CACTUS_BRIEF=
GEMINI_API_KEY=
GROQ_API_KEY=
NOVITA_API_KEY=
SILICONFLOW_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Set a comma-separated list only after each workload passes the seven-day pilot.
# First live admission still requires four verified independent providers.
ROUTER_PRODUCTION_WORKLOADS=
# Only for a supervised, nonpublishing calibration run:
ROUTER_PILOT_MODE=0
